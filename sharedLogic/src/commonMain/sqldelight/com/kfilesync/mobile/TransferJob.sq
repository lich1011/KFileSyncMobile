-- TransferJob.sq (design doc §10.1)
-- Transfer-aggregate persistence: per-job header + per-file items.

CREATE TABLE transfer_jobs (
    job_id            TEXT NOT NULL PRIMARY KEY,
    session_id        TEXT NOT NULL,
    job_type          TEXT NOT NULL,
    direction         TEXT NOT NULL DEFAULT 'incoming',
    peer_device_id    TEXT NOT NULL,
    share_id          TEXT,
    status            TEXT NOT NULL DEFAULT 'pending',
    total_bytes       INTEGER NOT NULL DEFAULT 0,
    transferred_bytes INTEGER NOT NULL DEFAULT 0,
    total_files       INTEGER NOT NULL DEFAULT 0,
    completed_files   INTEGER NOT NULL DEFAULT 0,
    error_message     TEXT,
    created_at        INTEGER NOT NULL,
    updated_at        INTEGER NOT NULL
);

CREATE TABLE transfer_items (
    job_id       TEXT NOT NULL,
    file_id      TEXT NOT NULL,
    file_path    TEXT NOT NULL,
    file_size    INTEGER NOT NULL,
    sha256       TEXT NOT NULL,
    status       TEXT NOT NULL DEFAULT 'pending',
    chunks_total INTEGER NOT NULL DEFAULT 0,
    chunks_done  INTEGER NOT NULL DEFAULT 0,
    temp_path    TEXT,
    PRIMARY KEY (job_id, file_id),
    FOREIGN KEY (job_id) REFERENCES transfer_jobs(job_id)
);

CREATE INDEX idx_transfer_jobs_status ON transfer_jobs(status);

findIncomplete:
SELECT * FROM transfer_jobs WHERE status IN ('pending', 'active', 'paused');

insertJob:
INSERT OR REPLACE INTO transfer_jobs(job_id, session_id, job_type, direction, peer_device_id, share_id, status, total_bytes, transferred_bytes, total_files, completed_files, error_message, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateProgress:
UPDATE transfer_jobs SET transferred_bytes = ?, completed_files = ?, status = ?, updated_at = ? WHERE job_id = ?;

getItemsForJob:
SELECT * FROM transfer_items WHERE job_id = ?;

insertItem:
INSERT OR REPLACE INTO transfer_items(job_id, file_id, file_path, file_size, sha256, status, chunks_total, chunks_done, temp_path)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateItemProgress:
UPDATE transfer_items SET chunks_done = ?, status = ? WHERE job_id = ? AND file_id = ?;