-- PairingRequest.sq (design doc §10.1)
-- Short-lived pairing handshake state (PIN + fingerprint + nonce).

CREATE TABLE pairing_requests (
    request_id     TEXT NOT NULL PRIMARY KEY,
    peer_device_id TEXT NOT NULL,
    direction      TEXT NOT NULL,
    status         TEXT NOT NULL DEFAULT 'pending',
    pin            TEXT NOT NULL,
    fingerprint    TEXT NOT NULL,
    nonce          TEXT NOT NULL,
    created_at     INTEGER NOT NULL,
    expires_at     INTEGER NOT NULL
);

findPending:
SELECT * FROM pairing_requests WHERE status = 'pending' AND expires_at > ?;

insert:
INSERT OR REPLACE INTO pairing_requests(request_id, peer_device_id, direction, status, pin, fingerprint, nonce, created_at, expires_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateStatus:
UPDATE pairing_requests SET status = ? WHERE request_id = ?;

cleanup:
DELETE FROM pairing_requests WHERE expires_at < ?;