-- Share.sq (design doc §10.1)
-- Shared-folder definitions + member authorizations.
--
-- Phase 3 (T3.1 / T3.5) adds:
--  - `updated_at` column on `shares` (for state-transition timestamps).
--  - `findAllActive` filter - drives the Shares List UI; "active" here
--    means status in ('active', 'paused') so paused shares stay visible.
--  - `findByStatus` for the Pending Invitations section.
--  - `updateStatus` / `updateLocalPath` for accept + pause/resume flows.

CREATE TABLE shares (
    share_id    TEXT NOT NULL PRIMARY KEY,
    share_name  TEXT NOT NULL,
    local_path  TEXT NOT NULL DEFAULT '',
    sync_mode   TEXT NOT NULL DEFAULT 'two_way',
    permission  TEXT NOT NULL DEFAULT 'read_write',
    status      TEXT NOT NULL DEFAULT 'pending',
    created_by  TEXT NOT NULL,
    created_at  INTEGER NOT NULL,
    updated_at  INTEGER NOT NULL
);

CREATE TABLE share_members (
    share_id      TEXT NOT NULL,
    device_id     TEXT NOT NULL,
    permission    TEXT NOT NULL DEFAULT 'read_write',
    authorized_by TEXT NOT NULL,
    authorized_at INTEGER NOT NULL,
    PRIMARY KEY (share_id, device_id),
    FOREIGN KEY (share_id) REFERENCES shares(share_id) ON DELETE CASCADE
);

CREATE INDEX idx_shares_status ON shares(status);

-- Phase 6 (T6.2): `getMembershipForDevice` filters on `device_id` only, so
-- without a secondary index we'd table-scan share_members on every policy
-- evaluation (PolicyEnforcer.canPush / canPull). The PRIMARY KEY's leading
-- column is `share_id`, which doesn't help this query.
CREATE INDEX IF NOT EXISTS idx_share_members_device ON share_members(device_id);

findById:
SELECT * FROM shares WHERE share_id = ?;

findByMember:
SELECT s.* FROM shares s
INNER JOIN share_members sm ON s.share_id = sm.share_id
WHERE sm.device_id = ?;

findAll:
SELECT * FROM shares;

findActiveOrPaused:
SELECT * FROM shares WHERE status IN ('active', 'paused');

findByStatus:
SELECT * FROM shares WHERE status = ?;

insertShare:
INSERT OR REPLACE INTO shares(share_id, share_name, local_path, sync_mode, permission, status, created_by, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateStatus:
UPDATE shares SET status = ?, updated_at = ? WHERE share_id = ?;

updateLocalPath:
UPDATE shares SET local_path = ?, status = ?, updated_at = ? WHERE share_id = ?;

deleteShare:
DELETE FROM shares WHERE share_id = ?;

insertMember:
INSERT OR REPLACE INTO share_members(share_id, device_id, permission, authorized_by, authorized_at)
VALUES (?, ?, ?, ?, ?);

removeMember:
DELETE FROM share_members WHERE share_id = ? AND device_id = ?;

removeAllMembersForShare:
DELETE FROM share_members WHERE share_id = ?;

getMembersForShare:
SELECT * FROM share_members WHERE share_id = ?;

getMembershipForDevice:
SELECT * FROM share_members WHERE device_id = ?;

removeMembershipsForDevice:
DELETE FROM share_members WHERE device_id = ?;