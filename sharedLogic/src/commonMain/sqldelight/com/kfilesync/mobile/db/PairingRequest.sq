-- PairingRequest.sq (design doc §10.1; expanded in Phase 1 T1.6)
-- Short-lived pairing handshake state (PIN + fingerprint + nonce).
--
-- Phase 0 had a slimmer column set; T1.6 added peer_fingerprint and
-- attempts_remaining so the PairingSession aggregate root (commonMain
-- domain.model.Pairing) round-trips losslessly through the DB.
CREATE TABLE pairing_requests (
    request_id          TEXT NOT NULL PRIMARY KEY,
    peer_device_id      TEXT NOT NULL,
    direction           TEXT NOT NULL,                  -- 'outgoing' | 'incoming'
    status              TEXT NOT NULL DEFAULT 'pending', -- 'pending' | 'succeeded' | 'failed' | 'expired' | 'cancelled'
    pin                 TEXT NOT NULL,
    peer_fingerprint    TEXT NOT NULL,
    nonce               TEXT NOT NULL,
    attempts_remaining  INTEGER NOT NULL DEFAULT 3,
    created_at          INTEGER NOT NULL,
    expires_at        INTEGER NOT NULL,
    -- Captured from PairRequestDto at receiveIncoming() time so
    -- confirmIncoming() can learn the peer's display identity without
    -- PairConfirmDto carrying it on the wire (issue #12).
    peer_alias        TEXT NOT NULL DEFAULT '',
    peer_platform     TEXT NOT NULL DEFAULT ''
);

-- Phase 6 (T6.2): `findPending` and `cleanup` both filter on `(status,
-- expires_at)`. A composite index covering both lets SQLite use the index
-- for the range scan instead of a table scan + sort.
CREATE INDEX IF NOT EXISTS idx_pairing_requests_status_expires
    ON pairing_requests(status, expires_at);

findById:
SELECT * FROM pairing_requests WHERE request_id = ?;

findPending:
SELECT * FROM pairing_requests
WHERE status = 'pending' AND expires_at > ?;

insert:
INSERT OR REPLACE INTO pairing_requests(
    request_id, peer_device_id, direction, status, pin, peer_fingerprint,
    nonce, attempts_remaining, created_at, expires_at, peer_alias, peer_platform
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateStatusAndAttempts:
UPDATE pairing_requests
SET status = ?, attempts_remaining = ?
WHERE request_id = ?;

cleanup:
DELETE FROM pairing_requests WHERE expires_at < ?;